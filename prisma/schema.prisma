generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password              String?
  onboardingCompleted   Boolean   @default(false)
  preferences           Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  propFirmAccounts   PropFirmAccount[]
  tradingAccounts    TradingAccount[]
  etfPlans           ETFPlan[]
  stockHoldings      StockHolding[]
  cryptoHoldings     CryptoHolding[]
  transactions       Transaction[]
  budgets            Budget[]
  netWorthSnapshots  NetWorthSnapshot[]
  incomeSources      IncomeSource[]
  incomeEntries      IncomeEntry[]
  budgetAllocations  BudgetAllocation[]
  expenses           Expense[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

// ─── PROP FIRM ───────────────────────────────────────────────────────────────

model PropFirmAccount {
  id              String            @id @default(cuid())
  userId          String
  firmName        String
  accountSize     Float
  accountType     PropAccountType
  status          PropAccountStatus
  startDate       DateTime
  endDate         DateTime?
  currency        String            @default("USD")
  balance         Float
  equity          Float
  profitTarget    Float?
  maxDrawdown     Float?
  currentDrawdown Float?
  totalPayout     Float             @default(0)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts PropPayout[]
}

model PropPayout {
  id        String       @id @default(cuid())
  accountId String
  amount    Float
  date      DateTime
  status    PayoutStatus @default(PENDING)
  notes     String?
  createdAt DateTime     @default(now())

  account PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

enum PropAccountType {
  CHALLENGE
  VERIFICATION
  FUNDED
}

enum PropAccountStatus {
  ACTIVE
  PASSED
  FAILED
  PAYOUT_REQUESTED
  CLOSED
}

enum PayoutStatus {
  PENDING
  RECEIVED
  REJECTED
}

// ─── TRADING PERSONALE ───────────────────────────────────────────────────────

model TradingAccount {
  id             String     @id @default(cuid())
  userId         String
  brokerName     String
  accountName    String
  currency       String     @default("USD")
  balance        Float
  initialDeposit Float
  assetClass     AssetClass
  isActive       Boolean    @default(true)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]
}

model Trade {
  id         String    @id @default(cuid())
  accountId  String
  symbol     String
  direction  TradeDir
  openDate   DateTime
  closeDate  DateTime?
  openPrice  Float
  closePrice Float?
  size       Float
  pnl        Float?
  pnlPct     Float?
  fees       Float     @default(0)
  notes      String?
  createdAt  DateTime  @default(now())

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

enum AssetClass {
  FOREX
  STOCKS
  CRYPTO
  FUTURES
  OPTIONS
  MIXED
}

enum TradeDir {
  LONG
  SHORT
}

// ─── ETF / PAC ───────────────────────────────────────────────────────────────

model ETFPlan {
  id            String   @id @default(cuid())
  userId        String
  name          String
  ticker        String
  isin          String?
  broker        String?
  frequency     PACFreq
  amount        Float
  startDate     DateTime
  currency      String   @default("EUR")
  totalInvested Float    @default(0)
  currentValue  Float    @default(0)
  avgPrice      Float?
  units         Float    @default(0)
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions ETFContribution[]
}

model ETFContribution {
  id        String   @id @default(cuid())
  planId    String
  date      DateTime
  amount    Float
  units     Float
  price     Float
  fees      Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())

  plan ETFPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

enum PACFreq {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

// ─── AZIONI ──────────────────────────────────────────────────────────────────

model StockHolding {
  id           String   @id @default(cuid())
  userId       String
  ticker       String
  companyName  String?
  exchange     String?
  broker       String?
  units        Float
  avgPrice     Float
  currentPrice Float?
  currency     String   @default("USD")
  sector       String?
  country      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockTransactions StockTransaction[]
}

model StockTransaction {
  id        String      @id @default(cuid())
  holdingId String
  type      StockTxType
  date      DateTime
  units     Float
  price     Float
  fees      Float       @default(0)
  total     Float
  notes     String?
  createdAt DateTime    @default(now())

  holding StockHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
}

enum StockTxType {
  BUY
  SELL
  DIVIDEND
}

// ─── CRYPTO ──────────────────────────────────────────────────────────────────

model CryptoHolding {
  id           String   @id @default(cuid())
  userId       String
  symbol       String
  name         String?
  exchange     String?
  wallet       String?
  amount       Float
  avgBuyPrice  Float
  currentPrice Float?
  currency     String   @default("USD")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cryptoTransactions CryptoTransaction[]
}

model CryptoTransaction {
  id        String       @id @default(cuid())
  holdingId String
  type      CryptoTxType
  date      DateTime
  amount    Float
  price     Float
  fees      Float        @default(0)
  total     Float
  notes     String?
  createdAt DateTime     @default(now())

  holding CryptoHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
}

enum CryptoTxType {
  BUY
  SELL
  TRANSFER_IN
  TRANSFER_OUT
  STAKE_REWARD
  AIRDROP
}

// ─── SPESE & BUDGET ──────────────────────────────────────────────────────────

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  category    String
  subcategory String?
  amount      Float
  currency    String          @default("EUR")
  date        DateTime
  description String?
  isRecurring Boolean         @default(false)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  month     Int
  year      Int
  category  String
  amount    Float
  currency  String   @default("EUR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year, category])
}

// ─── NET WORTH SNAPSHOT ──────────────────────────────────────────────────────

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  totalAssets      Float
  totalLiabilities Float    @default(0)
  netWorth         Float
  breakdown        Json
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ─── ENTRATE & BUDGET ────────────────────────────────────────────────────────

// Tipi di entrata definiti dall'utente (es. Stipendio, Prop Firm, Stripe...)
model IncomeSource {
  id        String   @id @default(cuid())
  userId    String
  name      String                      // es. "Stipendio", "Prop Firm FTMO"
  taxRate   Float    @default(0)        // percentuale tassazione 0-100
  isTaxed   Boolean  @default(false)
  color     String   @default("#3b82f6") // colore UI
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeEntries IncomeEntry[]
}

// Singola entrata di reddito
model IncomeEntry {
  id          String   @id @default(cuid())
  userId      String
  sourceId    String
  grossAmount Float                      // lordo
  taxAmount   Float                      // tasse calcolate
  netAmount   Float                      // netto = lordo - tasse
  taxRate     Float                      // snapshot del tax rate al momento
  date        DateTime
  month       Int
  year        Int
  description String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source IncomeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

// Allocazione budget mensile (% sul netto totale)
model BudgetAllocation {
  id         String   @id @default(cuid())
  userId     String
  month      Int
  year       Int
  category   BudgetCategory
  percentage Float                       // % del netto da allocare
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year, category])
}

// Spesa mensile categorizzata
model Expense {
  id          String         @id @default(cuid())
  userId      String
  category    BudgetCategory
  amount      Float
  description String?
  date        DateTime
  month       Int
  year        Int
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BudgetCategory {
  SPESE_NECESSARIE
  SPESE_GIORNALIERE
  INVESTIMENTI
  FONDO_EMERGENZA
  LIQUIDITA
}
